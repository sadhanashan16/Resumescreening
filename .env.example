# Copy to .env for local development (never commit .env). On Render these are set in render.yaml / the dashboard.

# --- required in production -------------------------------------------------
# Long random string used to sign sessions and CSRF tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
# PostgreSQL connection string (Render provides this). postgres:// and postgresql:// are both accepted.
# Leave empty locally to use a SQLite file at instance/resumeiq.db.
DATABASE_URL=

# --- environment ------------------------------------------------------------
# "production" turns on secure cookies, HSTS and proxy-header trust. Render also sets RENDER=true, which implies it.
APP_ENV=development
# Refuse to start in production without DATABASE_URL (recommended; render.yaml sets it).
REQUIRE_PERSISTENT_DB=false
LOG_LEVEL=INFO
PORT=5000

# --- authentication and security (all optional) ------------------------------
ALLOW_SIGNUP=true            # set to false to close registration once your team has accounts
MAX_FAILED_LOGINS=5          # failed logins before an account is locked
LOCKOUT_MINUTES=15
SESSION_HOURS=12             # how long a browser session lasts
REMEMBER_DAYS=14             # "Keep me signed in" duration
SESSION_COOKIE_SECURE=       # default: true in production, false otherwise
TRUST_PROXY=                 # default: true in production (trusts one proxy hop for scheme/IP)
RATELIMIT_STORAGE_URI=memory://   # use redis://... if you ever run more than one worker/instance

# --- uploads and model (all optional) ----------------------------------------
MAX_FILES=30
MAX_FILE_BYTES=5242880
MODEL_DIR=                   # default: ./models (trained at build time / first start)
APP_DATA_DIR=                # directory for the SQLite fallback database (default ./instance)
